# ==============================================================================
# Patent Bitirme Projesi - Ortam Değişkenleri Şablonu (.env.example)
# ==============================================================================
# Bu dosya, projede ilerleyen aşamalarda kullanılabilecek opsiyonel ve yerel
# yapılandırma parametrelerini örneklemek amacıyla hazırlanmıştır.
#
# GÜVENLİK UYARISI:
# - Gerçek API anahtarlarınızı veya gizli bilgilerinizi bu dosyaya ASLA yazmayınız.
# - Gerçek değerleri tanımlamak için bu dosyayı kopyalayarak '.env' adıyla
#   kaydediniz. '.env' dosyası .gitignore ile Git takibinden dışlanmıştır.
# ==============================================================================

# Uygulama Temel Ayarları
APP_ENV=development
APP_DEBUG=true
APP_HOST=localhost
APP_PORT=8501

# Veri ve Dizin Yapılandırmaları
DATA_DIR=data
MODELS_DIR=models

# Dil Modeli (LLM) Yapılandırması (Katman 2 - Yalnızca Taslak Üretimi)
# NOT: Hazır dil modeli yalnızca taslak üretiminde kullanılır; arama veya ML modelinde kullanılmaz.
# Yerel model (ör. Ollama) veya harici izinli API sağlayıcısı seçimi henüz kesinleştirilmemiştir.
# LLM_PROVIDER=local_or_api
# LLM_MODEL_NAME=model_identifier_placeholder
# LLM_API_KEY=your_secret_api_key_here
# LLM_API_BASE_URL=https://api.example.com/v1

